# train_A100_80GB.sub
#
# Provide HTCondor with the name of the Docker container
docker_image = rselagam/ndns:v51_cuda12.4.0_selagamsetty
universe = docker

executable = ndns_cmd.sh
log = A100_80GB_$(subject)_$(channel)_$(speech)_$(noiseStartIdx)_$(noiseEndIdx)_$(Cluster).log
output = A100_80GB_$(subject)_$(channel)_$(speech)_$(noiseStartIdx)_$(noiseEndIdx)_$(Cluster).out
error = A100_80GB_$(subject)_$(channel)_$(speech)_$(noiseStartIdx)_$(noiseEndIdx)_$(Cluster).err

# Specify that HTCondor should transfer files to and from the
#  computer where each job runs. The last of these lines *would* be
#  used if there were any other files needed for the executable to use.
should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
arguments = $(subject) $(channel) $(speech) $(noiseStartIdx) $(noiseEndIdx) $(batchSize) $(workers) $(prefetchFactor) $(saveProfile)
max_idle = 10
want_io_proxy = true
#TODO should change back to -15 when done with testing
priority = -15
batch_name = "A100_80GB_long_1247_1246"

+WantGPULab = true
+GPUJobLength = "long"

request_gpus = 1
request_cpus = 1
# There are A100s with 32 GB and 48 GB, so setting anything in the middle is pointless
request_memory = 48GB
# Though the job only uses 128GB, somtimes the disk usage spikes to 168GB
request_disk = 180GB
require_gpus = (Capability == 8.0) && (DriverVersion >= 12.4)
requirements = (HasCHTCStaging == True) && (CUDAGlobalMemoryMb > 80000)

# Tell HTCondor to run 1 instances of our job:
queue subject,channel,speech,noiseStartIdx,noiseEndIdx,batchSize,workers,prefetchFactor,saveProfile from configs_A100_80GB.txt 
